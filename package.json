{
    "name": "draft-duck",
    "private": true,
    "type": "module",
    "workspaces": [
        "app/client",
        "app/api",
        "app/core"
    ],
    "scripts": {
        "dev:client": "npm run dev -w @draft-duck/client",
        "dev:api": "npm run dev -w @draft-duck/api",
        "test": "npm run test -w @draft-duck/core",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx,css,json,md}": "prettier --write"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6"
    }
}
