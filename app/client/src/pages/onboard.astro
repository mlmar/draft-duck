---
// Quiz page. One React island, no per-question routes. client:only so persist does not fight SSR.
import { OnboardQuiz } from '@/components/onboard/onboard-quiz';
import Layout from '@/layouts/Layout.astro';
---

<Layout title='Onboard - Waiver Warrior'>
    <main class='mx-auto flex min-h-dvh max-w-lg flex-col px-4 py-10 md:max-w-2xl'>
        <OnboardQuiz client:only='react'>
            <p class='mb-0'>Loading quiz…</p>
        </OnboardQuiz>
    </main>
</Layout>
