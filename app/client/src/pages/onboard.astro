---
// Quiz stub. League size, draft type, and category weights land here next.
import { LinkButton } from '@/components/link-button';
import Layout from '@/layouts/Layout.astro';
---

<Layout title='Onboard - Waiver Warrior'>
    <main class='mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-4 py-10 md:max-w-2xl'>
        <p class='text-base font-medium text-primary'>Onboarding</p>
        <h1 class='mt-4 text-3xl font-semibold tracking-tight text-zinc-900 md:text-5xl'>Quiz coming soon</h1>
        <p class='mt-6 max-w-md text-base leading-relaxed text-zinc-800'>
            League size, draft type, and category need / punt land here next. Nothing to save yet.
        </p>
        <p class='mt-8'>
            <LinkButton href='/' variant='outline'>
                Back home
            </LinkButton>
        </p>
    </main>
</Layout>
