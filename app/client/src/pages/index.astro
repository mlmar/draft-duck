---
// Landing page. Sends people into the onboarding quiz.
import { LinkButton } from '@/components/link-button';
import Layout from '@/layouts/Layout.astro';
---

<Layout title='Waiver Warrior'>
    <main class='mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-4 py-10 md:max-w-2xl'>
        <p class='font-medium text-primary'>Fantasy basketball</p>
        <h1>Waiver Warrior</h1>
        <p class='max-w-md'>
            Set your category profile, rank the 2025-26 board with weighted z-scores, then see the next three to five
            remaining names at every pick.
        </p>
        <p class='mt-8'>
            <LinkButton href='/onboard'>Start</LinkButton>
        </p>
    </main>
</Layout>
