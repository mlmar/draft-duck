---
// Shared page shell. Title and description come from each page.
import '@/styles/global.css';

type Props = {
    title: string;
    description?: string;
};

const { title, description = 'Category-league fantasy basketball helper: quiz, weighted ranks, top remaining picks.' } =
    Astro.props;
---

<!doctype html>
<html lang='en'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <meta name='description' content={description} />
        <title>{title}</title>
    </head>
    <body class='min-h-dvh bg-background font-sans text-foreground antialiased'>
        <slot />
    </body>
</html>
