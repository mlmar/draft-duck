CLIENT_PORT=3000
API_PORT=3300
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:3000
PUBLIC_API_URL=https://localhost:3300
PUBLIC_BASE_PATH=/
# CSV_PATH=

# Dev API uses HTTPS and reads ~/.config/draft-duck/certs by default.
# HTTP fallback: npm run dev:api:http and PUBLIC_API_URL=http://localhost:3300.
# Override both paths together if the mkcert files are stored elsewhere.
# API_TLS_CERT_FILE=/absolute/path/to/localhost.pem
# API_TLS_KEY_FILE=/absolute/path/to/localhost-key.pem

# Optional weekly league comparison. Leave disabled until the migration and
# server secrets are configured. None of these belong in PUBLIC_ or VITE_ vars.
YAHOO_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Register this exact callback for local Yahoo testing.
YAHOO_REDIRECT_URI=https://localhost:3300/yahoo/oauth/callback
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
YAHOO_TOKEN_ENCRYPTION_KEY=
